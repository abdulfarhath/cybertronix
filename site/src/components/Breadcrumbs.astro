---
interface Props { trail: { name: string; path: string }[] }
const { trail } = Astro.props;
---
<nav aria-label="Breadcrumb" class="crumbs container">
  <ol>
    {trail.map((t, i) => (
      <li>{i < trail.length - 1 ? <a href={t.path}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { padding-top: var(--space-6); font-size: var(--text-sm); }
  ol { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: 0; padding: 0; color: var(--color-text-muted); }
  li + li::before { content: '/'; margin-right: var(--space-2); }
  a { color: var(--color-text-muted); }
</style>
