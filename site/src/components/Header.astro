---
import { PAGES, SITE } from '../config/site';
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {PAGES.filter((p) => p.href !== '/').map((p) => (
          <li><a href={p.href} aria-current={current === p.href ? 'page' : undefined}>{p.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); background: var(--color-bg); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-3); }
  .brand { font-weight: 700; font-size: var(--text-lg); text-decoration: none; letter-spacing: 0.02em; }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-block; padding-block: var(--space-2); text-decoration: none; color: var(--color-text-muted); font-size: var(--text-sm); }
  nav a:hover, nav a[aria-current='page'] { color: var(--color-text); }
</style>
