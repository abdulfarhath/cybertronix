---
/** Inner page shell: breadcrumbs (visible + BreadcrumbList schema), one H1, intro. */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbs } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  crumb: string;
  schema?: Record<string, unknown>[];
  type?: 'website' | 'product';
}

const { title, description, path, h1, crumb, schema = [], type } = Astro.props;
const trail = [{ name: 'Home', path: '/' }, { name: crumb, path }];
---
<BaseLayout title={title} description={description} path={path} type={type} schema={[...schema, breadcrumbs(trail)]}>
  <Breadcrumbs trail={trail} />
  <section class="section blueprint">
    <div class="container">
      <h1>{h1}</h1>
      <slot />
    </div>
  </section>
</BaseLayout>
