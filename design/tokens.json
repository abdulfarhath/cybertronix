{
  "$description": "Cybertronix Midnight Lab tokens. The ONE source for colours, type and shape (D33). Build reads this file; the canvas boards are generated from the same values (design/boards/).",
  "accent": {
    "meaning": "Blue means one thing: you can act here (buttons, links, focus, the selected item). Never decoration, never status.",
    "dark": "#3D7BFF",
    "button": { "dark": "#2F66E0", "light": "#2457C8" },
    "light": "#2457C8"
  },
  "signal": {
    "meaning": "Orange is not an accent. It only marks an alert or a TODO(founder) placeholder.",
    "dark": "#FF8A3D",
    "light": "#B9530F"
  },
  "color": {
    "dark": {
      "bg": "#0A0C10",
      "surface": "#141A22",
      "surface-sunk": "#10141B",
      "terminal": "#0D1016",
      "rule": "#232B36",
      "rule-strong": "#2E3846",
      "text": "#E8ECF2",
      "text-2": "#B7C0CD",
      "text-muted": "#8A94A4",
      "link": "#8FB2FF",
      "on-accent": "#FFFFFF"
    },
    "light": {
      "bg": "#F3F5F8",
      "surface": "#FFFFFF",
      "rule": "#D8DEE7",
      "rule-strong": "#C5CDD8",
      "text": "#0F141B",
      "text-2": "#3A4453",
      "text-muted": "#5A6475",
      "link": "#2457C8",
      "on-accent": "#FFFFFF"
    }
  },
  "grid": {
    "dark": { "line": "rgba(143,178,255,0.06)", "size": 40 },
    "light": { "minor": "rgba(36,87,200,0.06)", "minor-size": 24, "major": "rgba(36,87,200,0.12)", "major-size": 120 }
  },
  "shape": {
    "radius": 0,
    "rule": 2,
    "note": "Square corners everywhere (D33). Round shapes only for status dots and the play button, which are icons, not containers."
  },
  "type": {
    "display": { "family": "Unbounded", "weight": 500 },
    "text": { "family": "Geist", "weight": 400 },
    "mono": { "family": "JetBrains Mono", "weight": 400 },
    "scale": {
      "h1": [60, 65], "h1-phone": [34, 38],
      "h2": [40, 46], "h2-phone": [28, 32],
      "h3": [20, 28], "h3-phone": [16, 22],
      "lead": [19, 30], "body": [15, 23], "label": [13, 20]
    }
  },
  "space": { "base": 8, "container": 1280, "columns": 12, "gap": 20, "gutter": 80, "gutter-phone": 20, "section": 112, "section-phone": 56 },
  "breakpoints": [360, 390, 768, 1024, 1280, 1440],
  "motion": { "only": "hero head-turn on P1", "hover-ms": 150 }
}
